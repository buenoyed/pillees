# Pillees configuration.
# Copy to .env and fill in. .env is ignored by git.
# VITE_ values are built into the public website, so only put public things there.
# On Railway, set the same names under the "pillees" service > Variables.

# ---- Site ----
VITE_SITE_URL=https://pillees.fun

# ---- Official coin ----
VITE_COIN_NAME=Pillees
VITE_COIN_TICKER=PILLEES
# Contract address (mint). Leave empty until launch; the site shows "CA at launch".
VITE_COIN_CA=

# ---- Socials (full URLs). pump.fun links to the coin once VITE_COIN_CA is set ----
VITE_X_URL=
VITE_GITHUB_URL=https://github.com/buenoyed/pillees

# ---- Server only. Never prefix these with VITE_ ----
# Solana RPC, e.g. https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_URL=
# Postgres for bots, owners and trades (Railway sets this when you add Postgres)
DATABASE_URL=
# 32-byte hex secret that encrypts bot wallet keys. Generate: openssl rand -hex 32
BOT_KEY_SECRET=
